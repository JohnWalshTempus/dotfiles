{{ if eq .chezmoi.os "darwin" -}}
tm_icon="♟"
tm_color_active=colour213
{{- else }}
# Servers get their own colour and show the hostname, so a nested session is
# never mistaken for the local one
tm_icon="⚙ #h"
tm_color_active=colour214
{{- end }}
tm_color_inactive=colour241
tm_color_blue=colour4
tm_color_red=colour203

set -g status-left-length 32
set -g status-right-length 150
set -g status-interval 5

# True while F12 has handed keys to a nested tmux. Everything below that carries
# its own colour dims on this, so the whole bar reads as inactive. Defined before
# its first use: tmux expands $tm_off when each line is parsed.
tm_off="#{==:#{client_key_table},off}"

{{ if eq .chezmoi.os "darwin" -}}
set-option -g status-style fg=$tm_color_active
# Dimmed style for the F12 toggle (user option, format-expanded; ~/.tmux.conf
# parses before this file so it can't read $tm_* itself).
set -g @tm_dim_style fg=$tm_color_inactive,bg=colour236
{{ else -}}
# CUE 1 (status bar): servers get a tinted status bar. @tm_dim_style (used by the F12
# toggle in ~/.tmux.conf) keeps the tint when dimmed.
# Remove: delete tm_status_bg (set it to "") and the badge in tm_session_name.
tm_status_bg=",bg=colour58"
set-option -g status-style fg=$tm_color_active$tm_status_bg
set -g @tm_dim_style fg=$tm_color_inactive$tm_status_bg
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
set-window-option -g window-status-style fg=$tm_color_inactive
{{ else -}}
# Round 2: brighter than the colour58 bar so inactive windows stay readable
set-window-option -g window-status-style fg=colour252
{{ end -}}
set -g window-status-format "#I #W"
set-window-option -g window-status-current-style "fg=#{?$tm_off,$tm_color_inactive,$tm_color_active}"
set-window-option -g  window-status-current-format "#[bold]#I #W"
set-option -g pane-border-style fg=$tm_color_inactive
set-option -g pane-active-border-style fg=$tm_color_active
set-option -g message-style fg=$tm_color_active
set-option -g display-panes-active-colour $tm_color_active
set-option -g display-panes-colour $tm_color_inactive
set-window-option -g clock-mode-colour $tm_color_active

{{ if eq .chezmoi.os "darwin" -}}
battery_percent="#(~/.tmux/bin/bash/battery_indicator.sh)"
{{ else -}}
battery_percent=""
{{ end -}}
# Loud solid badge while keys are off (bold black on yellow)
tm_keys_off="#{?$tm_off,#[fg=colour16 bg=colour226 bold] KEYS OFF · F12 to return #[default] ,}"
tm_date="#[fg=#{?$tm_off,$tm_color_inactive,$tm_color_red}] %a %h-%d %H:%M"
{{ if eq .chezmoi.os "darwin" -}}
tm_session_name="#[fg=#{?$tm_off,$tm_color_inactive,$tm_color_blue},bold]$tm_icon #S"
{{- else }}
# CUE 1: solid hostname badge; stays bright even when F12 dims the bar
tm_session_name="#[fg=colour16,bg=colour214,bold] $tm_icon #[default]#[fg=#{?$tm_off,$tm_color_inactive,$tm_color_blue},bold] #S"
{{- end }}

set -g status-left $tm_session_name' '
set -g status-right $tm_keys_off$tm_date' '$battery_percent' '

{{- if ne .chezmoi.os "darwin" }}

# CUE 2 (terminal/tab title): the title goes out to the outer terminal; the Mac
# tmux passes it on to Ghostty (see set-titles in the darwin ~/.tmux.conf).
# Remove: delete these two lines.
set -g set-titles on
set -g set-titles-string "#h · #S:#W"

# CUE 3 (hotkey hint): a faint second status line. #{prefix} is read when the
# bar is drawn, so a prefix changed in ~/.tmux.conf.local shows correctly.
# Remove: delete these two lines (or `set -g status on` for one line).
set -g status 2
set -g status-format[1] "#[align=left,fg=colour250] #{prefix} prefix · a send prefix · F12 pass keys to nested tmux · #{prefix} C-s workmux dashboard"

# CUE 4 (pane tint, off by default): uncomment to tint server panes slightly.
# set -g window-style bg=colour234
{{- end }}
