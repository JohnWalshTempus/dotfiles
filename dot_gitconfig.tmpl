[user]
	name = {{ .name }}
	email = {{ .email }}
{{- if .signingKey }}
	signingkey = {{ .signingKey }}
{{- end }}
{{- if .githubUser }}

[github]
	user = {{ .githubUser }}
{{- end }}

[alias]
	pushup = "!git push --set-upstream origin $(git symbolic-ref --short HEAD)"
	co = checkout
	s = status --short
	lg = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'

[color]
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  ui = auto

[color "branch"]
  current = green bold
  local = green
  remote = red bold

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = green bold
  changed = yellow bold
  untracked = red

[color "sh"]
  branch = yellow

[push]
    # push will only do the current branch, not all branches
  default = current

[branch]
    # set up 'git pull' to rebase instead of merge
  autosetuprebase = always
  autosetupmerge = always

[diff]
  renames = copies
  mnemonicprefix = true
  colormoved = default
  colormovedws = allow-indentation-change

[difftool]
  prompt = false

[apply]
    # do not warn about missing whitespace at EOF
  whitespace = nowarn

[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
{{- if lookPath "delta" }}
	pager = delta

[interactive]
	diffFilter = delta

[delta]
  line-numbers = true
  side-by-side = true
  features = decorations
  whitespace-error-style = 22 reverse

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
{{- end }}

[rerere]
	enabled = true

[grep]
	extendRegexp = true
	lineNumber = true
{{- if eq .chezmoi.os "darwin" }}

[credential]
	helper = osxkeychain
{{- end }}
{{- if lookPath "git-lfs" }}

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- end }}

[pull]
	rebase = false

[merge]
	conflictstyle = diff3

[init]
	defaultBranch = main
{{- if .signingKey }}

[commit]
	gpgsign = true
{{- end }}

[include]
	path = ~/.gitconfig.local
