set -g history-limit 20000
set -g renumber-windows on

unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

set -g focus-events on
bind-key a send-prefix

setw -g aggressive-resize on
set -sg escape-time 0

set -g base-index 1
setw -g pane-base-index 1

setw -g mode-keys vi
# OSC 52 sends copies to the local terminal's clipboard, through ssh and
# through an outer tmux when nested
set -s set-clipboard on
set -as terminal-features ',xterm*:clipboard'
{{- if eq .chezmoi.os "darwin" }}
set -s copy-command 'pbcopy'
{{- end }}

bind r source-file ~/.tmux.conf \; display "Config Reloaded!"
bind N new-window
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind -r C-h select-window -t :-

bind -r H resize-pane -L 10
bind -r J resize-pane -D 10
bind -r K resize-pane -U 10
bind -r L resize-pane -R 10

setw -g mouse on

unbind [
bind Escape copy-mode
unbind p
bind p paste-buffer
bind -Tcopy-mode-vi 'v' send -X begin-selection
bind -Tcopy-mode-vi 'y' send -X copy-pipe-and-cancel

{{ if eq .chezmoi.os "darwin" -}}
bind C-c run 'tmux save-buffer - | pbcopy'
bind C-v run 'pbpaste | tmux load-buffer - ; tmux paste-buffer'
{{ end -}}

bind C-s display-popup -h 30 -w 100 -E "workmux dashboard"
bind C-t run-shell "workmux sidebar --session"

unbind Up
bind Up new-window -d -n fullscreen \; swap-pane -s fullscreen.1 \; select-window -t fullscreen
unbind Down
bind Down last-window \; swap-pane -s fullscreen.1 \; kill-window -t fullscreen

bind C-l send-keys 'C-l'

bind-key -n C-S-Left swap-window -t -1
bind-key -n C-S-Right swap-window -t +1

bind-key / copy-mode \; send-keys /
bind-key ? copy-mode \; send-keys ?

source ~/.tmux/theme.sh

# F12 hands every key, prefix included, to a tmux nested inside this one (e.g.
# ssh'd into a server session). The status bar dims while it's off; F12 again
# takes the keys back.
bind -T root F12 \
  set prefix None \; \
  set key-table off \; \
  set status-style "fg=$tm_color_inactive" \; \
  if -F '#{pane_in_mode}' 'send-keys -X cancel' \; \
  refresh-client -S
bind -T off F12 \
  set -u prefix \; \
  set -u key-table \; \
  set -u status-style \; \
  refresh-client -S

source-file -q ~/.tmux.conf.local
